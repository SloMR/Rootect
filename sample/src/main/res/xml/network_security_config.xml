<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext to the loopback verifier only, reached via `adb reverse`. A real deployment
     talks to its own backend over TLS and needs none of this. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
